{
  "name": "dup-audit",
  "version": "1.0.0",
  "description": "Deterministic (non-AI) duplicate-code audit with verified coverage and unattended CI gates",
  "type": "module",
  "bin": {
    "dup-audit": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "audit": "node dist/src/cli.js"
  },
  "dependencies": {
    "jscpd": "^4.0.5",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.10",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3"
  }
}